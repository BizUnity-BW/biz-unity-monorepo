DATABASE_URL="postgresql://bizunity:bizunity@localhost:5432/bizunity?schema=public"
DIRECT_URL="postgresql://bizunity:bizunity@localhost:5432/bizunity?schema=public"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Storage buckets, created by `npm run storage:provision`.
# The documents bucket is private (signed URLs only); the public one holds logos
# and avatars, which render in <img> on every page.
SUPABASE_BUCKET_DOCUMENTS="bizunity-documents"
SUPABASE_BUCKET_PUBLIC="bizunity-public"
# Lifetime of a document download URL. Minted per click, never cached.
SIGNED_URL_TTL_SECONDS=300

FLAGSMITH_ENVIRONMENT_KEY="your-flagsmith-key"
FRONTEND_URL="http://localhost:5173"
PORT=4000
NODE_ENV=development
RATE_LIMIT_ENABLED=true
