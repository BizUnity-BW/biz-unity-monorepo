{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm ci && npm run generate && npm run build"
  },
  "deploy": {
    "preDeployCommand": "npm run migrate:deploy",
    "startCommand": "npm start",
    "restartPolicyType": "ON_FAILURE"
  }
}
